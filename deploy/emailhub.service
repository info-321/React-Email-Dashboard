[Unit]
Description=Email Hub Flask WSGI application
After=network.target

[Service]
Type=simple
User=emailhub
Group=www-data
WorkingDirectory=/srv/emailhub/server
EnvironmentFile=/etc/emailhub/emailhub.env
Environment=PYTHONDONTWRITEBYTECODE=1
RuntimeDirectory=emailhub
RuntimeDirectoryMode=0750
UMask=0007
# Serialize requests while the mailbox list uses a JSON file.
ExecStart=/srv/emailhub/.venv/bin/gunicorn --workers 1 --threads 1 --timeout 180 --bind unix:/run/emailhub/gunicorn.sock --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/emailhub /run/emailhub

[Install]
WantedBy=multi-user.target
