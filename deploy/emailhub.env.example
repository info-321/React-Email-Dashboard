# Copy to /etc/emailhub/emailhub.env and replace these placeholders.
# systemd reads this file. The Flask app does not load .env files itself.
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-long-unique-password
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
SESSION_COOKIE_SECURE=true
EMAIL_STORE=/var/lib/emailhub/emails.json
GOOGLE_APPLICATION_CREDENTIALS=/etc/emailhub/workspace_service_account.json
# Leave empty when the React site and API share a domain.
CORS_ORIGINS=
NOTION_API_SECRET=
NOTION_DATABASE_ID=
