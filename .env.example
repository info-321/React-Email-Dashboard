# Production Docker Compose settings for the EWorkspace project only.
# Copy to .env, set all three required credentials, then chmod 600 .env.
# Quote values containing $ or # with single quotes.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Generate independently: python3 -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=
EWORKSPACE_PORT=8161
CORS_ORIGINS=
# Optional: migrate the original project's Notion credentials/schema mappings.
NOTION_API_SECRET=
NOTION_DATABASE_ID=
# NOTION_PROP_DATE='Send Date'
# NOTION_PROP_CAMPAIGN='Email Subject'
